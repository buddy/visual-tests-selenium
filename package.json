{
  "name": "@buddy-works/visual-tests-selenium",
  "version": "1.0.0",
  "description": "Buddy Visual Test SeleniumJS Plugin",
  "keywords": [
    "buddy",
    "buddy-works",
    "ci",
    "e2e",
    "e2e-testing",
    "image-comparison",
    "image-diff",
    "regression",
    "screenshot",
    "screenshot-testing",
    "selenium",
    "selenium-plugin",
    "selenium-webdriver",
    "test-automation",
    "testing",
    "ui-testing",
    "visual testing",
    "visual-regression",
    "visual-testing"
  ],
  "license": "MIT",
  "author": "Bartosz Wróbel",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/types/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "build": "node build.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/selenium-webdriver": "4.35.5",
    "esbuild": "0.28.2",
    "esbuild-node-externals": "2.0.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "selenium-webdriver": ">=4.16.0"
  },
  "engines": {
    "node": ">=20"
  }
}
